{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/queue-delivery.mjs": {
      "maxDuration": 30,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "factory-staging-delivery-check"
        }
      ]
    },
    "api/infrastructure.mjs": {
      "maxDuration": 180
    },
    "api/*.mjs": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
