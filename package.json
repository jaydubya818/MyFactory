{
  "name": "sellerfi-local-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.22.1 <25" },
  "overrides": {
    "@vercel/queue@0.7.0": { "minimatch": "11.0.1" },
    "@vercel/cli-config@0.2.3": { "zod": "4.6.6" },
    "@vercel/cli-config@0.3.1": { "zod": "4.6.6" }
  },
  "scripts": {
    "dev": "npm run dev --workspace @factory/supervisor",
    "start": "npm run start --workspace @factory/supervisor",
    "start:connected": "node --env-file=data/connections.env apps/supervisor/src/server.ts",
    "dev:web": "npm run dev --workspace @factory/web",
    "build": "npm run build --workspaces --if-present",
    "preview:prepare": "npm ci --prefix templates/feedback-hub --ignore-scripts --no-audit --no-fund",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:producer": "tsc --noEmit -p tsconfig.producer.json",
    "check:producer-governance": "node scripts/check-producer-governance.mjs",
    "smoke:docker": "node scripts/smoke-supervisor.mjs"
  }
}
